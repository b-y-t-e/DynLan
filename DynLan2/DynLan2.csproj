<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>DynLan2</RootNamespace>
    <AssemblyName>DynLan2</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Description>DynLan 2 — a fast, Python-syntax scripting language for .NET with resumable, serializable execution state and a tiered JIT.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynLan2.Tests" />
    <InternalsVisibleTo Include="DynLan2.Bench" />
  </ItemGroup>

</Project>
