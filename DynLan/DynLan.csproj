<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0</TargetFrameworks>
    <RootNamespace>DynLan</RootNamespace>
    <AssemblyName>DynLan</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- NuGet packaging. Deploy/publish.py bumps <Version> and nothing else. -->
  <PropertyGroup>
    <Version>1.2.10</Version>
    <PackageId>DynLan</PackageId>
    <Authors>b-y-t-e</Authors>
    <Company>b-y-t-e</Company>
    <Copyright>Copyright (c) b-y-t-e</Copyright>
    <Description>A tiny dynamic scripting language for .NET — compile a string, run it, get a value back. Classes, closures, try/catch, full two-way interop with your C# objects. No DLR, no Reflection.Emit, runs on frameworks as old as .NET 2.0.</Description>
    <PackageTags>scripting script dynamic interpreter expression evaluator dsl</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/b-y-t-e/DynLan</PackageProjectUrl>
    <RepositoryUrl>https://github.com/b-y-t-e/DynLan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fasterflect" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

</Project>
