<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- dotnet run -c Release -p:EngineTarget=netstandard2.1  benchmarks the netstandard2.1 build of the engine -->
    <ProjectReference Include="..\DynLan2\DynLan2.csproj" Condition="'$(EngineTarget)' == ''" />
    <ProjectReference Include="..\DynLan2\DynLan2.csproj" Condition="'$(EngineTarget)' != ''" SetTargetFramework="TargetFramework=$(EngineTarget)" />
    <ProjectReference Include="..\DynLan\DynLan.csproj" />
  </ItemGroup>

</Project>
